# PostgreSQL
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev
POSTGRES_DB=helpdesk

# Backend
PORT=8080
DATABASE_URL=postgres://helpdesk:helpdesk_dev@localhost:5432/helpdesk?sslmode=disable
JWT_SECRET=dev-secret-change-in-prod
CORS_ORIGINS=http://localhost:3000

# Email (SMTP) — Mailpit on :1025 for dev, UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Help Desk <helpdesk@fintara.com>

# Frontend (NEXT_PUBLIC_* are inlined at build/serve time)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
